{
  "name": "mobile-automation-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Automacao mobile do WebdriverIO Native Demo App com Appium.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "apps:download": "node scripts/download-apps.mjs",
    "test": "npm run test:android",
    "test:android": "cross-env PLATFORM=android wdio run ./wdio.conf.js",
    "test:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.js",
    "report:allure": "allure generate allure-results --clean --output allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "allure-commandline": "2.46.1",
    "appium": "3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "chai": "6.2.2",
    "cross-env": "10.1.0",
    "dotenv": "17.2.3"
  },
  "allowScripts": {
    "appium@3.8.0": true,
    "esbuild@0.28.2": true,
    "edgedriver": false,
    "geckodriver": false
  }
}
